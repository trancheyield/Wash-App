# tools/demo і scripts/wsl-deploy.sh (Node читає через --env-file, WSL — sed по цьому файлу)
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet
WASH_PROGRAM_ID=2Yq39tVgTH5e8be8YdssyhvM6339f2WG6QweNmxGpBbf
# Тека з ключами оператора й upgrade authority (типово ~/.config/washapp у WSL);
# ключі в репо не потрапляють.
WASH_KEYS_DIR=

# apps/web (Vite читає лише VITE_*). Порожній RPC = публічний devnet.
VITE_SOLANA_RPC_URL=
VITE_WASH_PROGRAM_ID=2Yq39tVgTH5e8be8YdssyhvM6339f2WG6QweNmxGpBbf
# Пул, який відкривається за замовчуванням (u16); порожньо = 0.
VITE_WASH_DEFAULT_POOL=0
